#!/bin/busybox sh

echo "Nimbus init: starting"

# Emergency shell
rescue_shell() {
    echo
    echo "Nimbus init: Error"
    echo "Nimbus init: dropping to emergency shell"
    exec /bin/sh
}

echo "Nimbus init: mounting virtual filesystems"

mount -t devtmpfs devtmpfs /dev || rescue_shell
mount -t proc proc /proc || rescue_shell
mount -t sysfs sysfs /sys || rescue_shell

echo "Nimbus init: virtual filesystems mounted"

# Read root= from kernel command line
ROOT_DEV="$(sed -n 's/.*root=\([^ ]*\).*/\1/p' /proc/cmdline)"

if [ -z "$ROOT_DEV" ]; then
    echo "Nimbus init: no root= specified"
    echo "Nimbus init: defaulting to /dev/vda2"
    ROOT_DEV="/dev/vda2"
fi

echo "Nimbus init: root device = $ROOT_DEV"

mkdir -p /mnt/root

echo "Nimbus init: mounting real root filesystem"

mount "$ROOT_DEV" /mnt/root || rescue_shell

echo "Nimbus init: root filesystem mounted"

# Verify required files actually exist and are executable
if [ ! -x /mnt/root/bin/sh ]; then
    echo "Nimbus init: ERROR: /mnt/root/bin/sh does not exist or is not executable"
    rescue_shell
fi

if [ ! -x /mnt/root/sbin/init ]; then
    echo "Nimbus init: ERROR: /mnt/root/sbin/init does not exist or is not executable"
    echo "Nimbus init: entering shell for debugging"
    exec /bin/sh
fi

echo "Nimbus init: switching to real root"

exec switch_root /mnt/root /sbin/init